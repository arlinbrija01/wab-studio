# ---------------------------------------------------------------
# Modulo contatti — Resend (https://resend.com/api-keys)
# ---------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Dove arrivano le richieste. Se lo lasci vuoto usa l'email
# impostata nel pannello, in Impostazioni.
CONTACT_TO_EMAIL=
# Mittente verificato su Resend (onboarding@resend.dev per le prove)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------
# Pannello di amministrazione
# Genera questi valori con:  npm run admin:password -- "la-tua-password"
# ---------------------------------------------------------------
ADMIN_EMAIL=info@wabstudio.it
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Indirizzo segreto del pannello: /pannello-xxxxxxxx
ADMIN_PATH=pannello
